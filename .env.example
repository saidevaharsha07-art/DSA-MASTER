# System Environment Configuration Template (Placeholders Only - No Secrets)
NEXT_PUBLIC_APP_NAME=DSA-Master Platform
NEXT_PUBLIC_VERSION=5.10.0
NODE_ENV=development

# Authentication Provider Configuration (Supabase Auth)
# Public keys used on client for Supabase Auth API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Private Secret Server Keys (NEVER expose to client side or NEXT_PUBLIC_* variables)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
DATABASE_URL=postgresql://user:password@localhost:5432/dsamaster

# Provider Selection
AUTH_PROVIDER=supabase
SYNC_PROVIDER=local
REALTIME_PROVIDER=local_realtime
BACKUP_PROVIDER=local_backup
NOTIFICATION_PROVIDER=in_app
ANALYTICS_PROVIDER=local
DATABASE_PROVIDER=memory

# Provider Stubs & OAuth Configuration
REDIS_URL=redis://localhost:6379

GOOGLE_CLIENT_ID=placeholder_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret
GITHUB_CLIENT_ID=placeholder_github_client_id
GITHUB_CLIENT_SECRET=placeholder_github_client_secret

FIREBASE_PROJECT_ID=placeholder_firebase_project_id

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dsamaster

S3_BUCKET=dsamaster-backups
S3_REGION=us-east-1

SENDGRID_KEY=placeholder_sendgrid_key
ONESIGNAL_APP_ID=placeholder_onesignal_app_id
