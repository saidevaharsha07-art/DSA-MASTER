# ==============================================================================
# DSA MAGNA — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Safe placeholders only. NEVER commit real secret values to version control.
#
# Environment Target Mapping:
# - Local:      Set in .env.local (ignored by git)
# - Preview:    Set in Vercel Project Settings -> Environment Variables (Preview)
# - Production: Set in Vercel Project Settings -> Environment Variables (Production)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC ENVIRONMENT VARIABLES (Client & Browser Accessible: NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------

# Application Identity & Version
NEXT_PUBLIC_APP_NAME=DSA Magna
NEXT_PUBLIC_VERSION=1.0.0

# Canonical URLs (Local: http://localhost:3000 | Preview: https://<preview-branch>.vercel.app | Prod: https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public API Access (Required in Local, Preview, Production)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-anon-key

# AI Provider Preference (gemini | openai)
NEXT_PUBLIC_AI_PROVIDER=gemini


# ------------------------------------------------------------------------------
# 2. SERVER-ONLY ENVIRONMENT VARIABLES (Private Secrets — NEVER expose to client)
# ------------------------------------------------------------------------------

# Node Runtime Environment (development | production | test)
NODE_ENV=development

# Supabase Service Role Key (Admin access for migrations and maintenance)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role secret
# Local: .env.local | Preview: Vercel Preview | Production: Vercel Production
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-service-role-key

# Direct PostgreSQL Connection URL (Optional, for direct migrations/Prisma if needed)
DATABASE_URL=postgresql://postgres:placeholder_password@db.your-project-id.supabase.co:5432/postgres

# Google Gemini API Key (Server-side AI Mentor queries)
# Found in: Google AI Studio -> Get API Key
# Local: .env.local | Preview: Vercel Preview | Production: Vercel Production
GEMINI_API_KEY=AIzaSyPlaceholderGeminiApiKeyForDsaMagna

# Dedicated Isolated Judge Engine URLs (Phase 5 - Required for Production Launch)
# External sandboxed Judge0 or Piston cluster URL (e.g. https://judge.yourdomain.com)
# Local: optional (falls back to local runner) | Production: MANDATORY dedicated sandbox
JUDGE0_URL=https://judge0-api.yourdomain.com
PISTON_URL=https://piston-api.yourdomain.com

# OAuth Client Credentials (Configured in Supabase Auth -> Providers)
# These are managed directly within the Supabase Dashboard, but documented here for completeness:
# GOOGLE_CLIENT_ID=placeholder_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=placeholder_google_client_secret
# GITHUB_CLIENT_ID=placeholder_github_client_id
# GITHUB_CLIENT_SECRET=placeholder_github_client_secret
